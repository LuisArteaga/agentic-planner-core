# API Keys & Credentials
OPENROUTER_API_KEY=your_openrouter_api_key_here
GH_PAT=your_github_personal_access_token_here
# Optional: Model selection (e.g. z-ai/glm-5.2, anthropic/claude-3.5-sonnet, etc.)
AGENT_MODEL=z-ai/glm-5.2

# Target Repository Configuration
GITHUB_WORKSPACE=your_target_repository_path_here
GITHUB_REPOSITORY=LuisArteaga/agentic-planner-core

# Optional: Langfuse Tracing Telemetry
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key_here
LANGFUSE_SECRET_KEY=your_langfuse_secret_key_here
