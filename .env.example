# API Keys & Credentials
OPENROUTER_API_KEY=your_openrouter_api_key_here
GH_PAT=your_github_personal_access_token_here
# Optional: Model Selection & Routing
# AGENT_MODEL defines the global fallback model
AGENT_MODEL=z-ai/glm-5.2

# Phase-Specific Models (falls back to AGENT_MODEL if not set)
GRILL_MODEL=z-ai/glm-5.2
VERIFY_MODEL=z-ai/glm-5.2
DRAFT_MODEL=deepseek/deepseek-v4-pro

# Refinement Phase Sub-Nodes Models (falls back to REFINE_MODEL -> AGENT_MODEL)
REFINE_MODEL=
REFINE_ANALYZE_SOURCES_MODEL=deepseek/deepseek-v4-flash
REFINE_WEB_SEARCH_MODEL=deepseek/deepseek-v4-flash
REFINE_PROPOSE_OPTIONS_MODEL=deepseek/deepseek-v4-pro
REFINE_EVALUATE_GRADE_MODEL=z-ai/glm-5.2
REFINE_APPLY_DECISION_MODEL=moonshotai/kimi-k2.7-code

# CI/CD PR Judges Model Overrides (optional, overrides factory.json configuration)
# PR_SYNTAX_LINT_MODEL=moonshotai/kimi-k2.7-code
# PR_TEST_COVERAGE_MODEL=moonshotai/kimi-k2.7-code
# PR_ARCHITECTURE_MODEL=z-ai/glm-5.2
# PR_SECURITY_MODEL=deepseek/deepseek-v4-pro

# Target Repository Configuration
GITHUB_WORKSPACE=your_target_repository_path_here
GITHUB_REPOSITORY=LuisArteaga/agentic-planner-core

# Optional: Langfuse Tracing Telemetry
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key_here
LANGFUSE_SECRET_KEY=your_langfuse_secret_key_here
